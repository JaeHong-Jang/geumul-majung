# Windows에서 run-windows.ps1(서버)과 안드로이드 빌드가 되는지 확인하고,
# 에뮬레이터에 끌어다 놓을 수 있는 APK를 Artifacts로 남긴다.
name: windows-android

on:
  push:
    paths: ['janjaemi-app/**', 'backend/**', 'run-windows.ps1', '.github/workflows/windows-android.yml']
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: '3.12' }
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: '17' }
      - uses: subosito/flutter-action@v2
        with: { channel: stable, cache: true }

      - name: 서버 켜고 데모 계정으로 로그인
        shell: powershell
        run: |
          .\run-windows.ps1 -ServerOnly
          $body = @{ login_id = '000-00-00004'; password = 'janjaemi-demo-password' } | ConvertTo-Json
          $r = Invoke-RestMethod http://127.0.0.1:8000/v1/auth/login -Method Post -ContentType 'application/json' -Body $body
          if ($r.company.role -ne 'recycler') { throw "로그인 응답 이상: $($r | ConvertTo-Json)" }

      - name: APK 빌드
        working-directory: janjaemi-app
        run: flutter build apk --debug --dart-define=API_BASE=http://10.0.2.2:8000

      - uses: actions/upload-artifact@v4
        with:
          name: janjaemi-debug-apk
          path: janjaemi-app/build/app/outputs/flutter-apk/app-debug.apk
